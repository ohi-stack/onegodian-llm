NODE_ENV=development
PORT=3100
OLLM_VERSION=0.2.0
OLLM_MODEL_ID=onegodian-llm

# Protect POST /v1/chat/completions. Production requires a strong server-side key.
OLLM_API_KEY=

# OLLM uses an OpenAI-compatible backend contract in this production-readiness slice.
# Production requires both URL and model. Keep credentials in the environment only.
OLLM_BACKEND_URL=
OLLM_BACKEND_MODEL=
OLLM_BACKEND_API_KEY=
OLLM_REQUEST_TIMEOUT_MS=30000
