{
  "name": "onegodian-llm",
  "version": "0.2.0",
  "private": true,
  "description": "OneGodian LLM runtime and provider-neutral model gateway for OMOS.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "demo:strategy": "tsx src/demo/strategy.ts",
    "preflight:production": "node scripts/preflight-production.mjs",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "test": "npm run check && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
